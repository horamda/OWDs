# ID del Google Sheet de OWDs (lo que está entre /d/ y /edit en el link)
SHEET_ID=1q5Q54vzSTUAuRnxVjtg87Bjohn0NwK2p2rrkzNZvld0
# Contenido completo del JSON de la cuenta de servicio, en una sola línea
GOOGLE_CREDENTIALS_JSON=
# public (por defecto): lectura sin credenciales; private: cuenta de servicio
SHEET_ACCESS=public
# Opcional: contraseña para entrar a la web (usuario: cualquiera)
ACCESS_PASSWORD=
# Opcional: segundos que se cachea la lectura del Sheet
CACHE_SECONDS=60
